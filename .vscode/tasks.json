{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Numerica",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"streamlit",
				"run",
				"${workspaceFolder}\\app.py"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Run Streamlit app",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe -m streamlit run app.py",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}